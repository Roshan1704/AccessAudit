# Copy to a local untracked file and fill in. Never commit real values.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5432
# Runtime connection: the aa_api role (subject to row-level security).
DATABASE_URL=postgresql://aa_api:change_me@localhost:5432/accessaudit
# Owner connection used only by `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgresql://accessaudit:change_me@localhost:5432/accessaudit
# Integration tests (aa_api against a migrated dev database).
TEST_DATABASE_URL=postgresql://aa_api:change_me@localhost:5432/accessaudit
# Worker connection: the aa_worker role (needs LOGIN + password set by the database owner).
WORKER_DATABASE_URL=postgresql://aa_worker:change_me@localhost:5432/accessaudit
TEST_WORKER_DATABASE_URL=postgresql://aa_worker:change_me@localhost:5432/accessaudit
DOMAIN_REVALIDATE_DAYS=30
DNS_RESOLVER=
VITE_API_URL=http://localhost:4000
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=accessaudit-artifacts
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me

# 32-byte base64 key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_CURRENT=
ENCRYPTION_KEY_ID=k1

API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
SESSION_COOKIE_SECRET=
WEB_ORIGIN=http://localhost:3000

WORKER_CONCURRENCY=2
CRAWL_ALLOW_PRIVATE_NETWORKS=false
# DEVELOPMENT ONLY. Allows scans of private-network hosts and weakens SSRF protection. Must be false in production.
ALLOW_PRIVATE_TARGETS=false
# Set to "off" on extra API replicas. Disables scheduled scans and scan notification emails on that process.
SCHEDULER=on

# none | openai | anthropic | gemini | openai-compatible
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Bearer token for GET /metrics (16+ characters). Unset disables the endpoint.
# METRICS_TOKEN=
# Minutes a scan may stay running before the API marks it failed (worker_lost).
STUCK_SCAN_MINUTES=60

# Mail delivery. POSTs {from,to,subject,text} JSON with a bearer key to MAIL_API_URL.
# When either is unset, mail is only logged (development).
# MAIL_API_URL=
# MAIL_API_KEY=
# MAIL_FROM=AccessAudit <no-reply@example.com>
# Receives a JSON POST for each unhandled server error (stack, request id, route).
# ERROR_WEBHOOK_URL=
# Authenticated scanning (ADR-031). 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Needed by BOTH api and worker. Without it login profiles cannot be created or used.
# CREDENTIAL_ENCRYPTION_KEY=
# CREDENTIAL_KEY_ID=k1
