    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "bullmq": "6.7.4",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.1.0",
    "ioredis": "6.0.0",
    "playwright-core": "1.65.0",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
